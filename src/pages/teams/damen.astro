---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { teamCards } from '../../data/site';
import TeamGirl3Svg from '../../components/svg/TeamGirl3Svg.astro';
import TeamGirl2Svg from '../../components/svg/TeamGirl2Svg.astro';
import PlaySvg from '../../components/svg/PlaySvg.astro';

const team = teamCards.find((item) => item.slug === 'damen');

if (!team) {
  throw new Error('Damen page data not found');
}
---

<BaseLayout title={`${team.name} | Saarower VSV`} description={team.description}>
  <section class={`team-page team-page--${team.accent}`}>
    <div class="shell">
      <div class="team-page__inner">
        <div class="hero-stage">
          <div class="subpage-back-row legal-content-page__back-row">
            <a class="subpage-back-link" href="/#teams">← Zurück zu den Teams</a>
          </div>

          <div class="hero-stage__body legal-content-page__hero-copy">
            <h1>{team.name}</h1>
          </div>
        </div>

        <article class="team-page__hero-card">
          <div class="team-page__art">
            <div class="team-page__art-item team-page__art-item--play">
              <PlaySvg />
            </div>

            <div class="team-page__art-item team-page__art-item--jump">
              <TeamGirl2Svg />
            </div>

            <div class="team-page__content">
              <div class="team-page__section">
                <p class="team-page__card-label">Beschreibung</p>
                <p>{team.description}</p>
              </div>

              <div class="team-page__section">
                <p class="team-page__card-label">Trainingszeiten</p>
                <ul class="team-page__schedule">
                  {team.schedule.map((entry) => <li>{entry}</li>)}
                </ul>
              </div>

              <div class="team-page__section">
                <p class="team-page__card-label">Ansprechpartner</p>
                <p class="team-page__contact-name">{team.contactName}</p>
              </div>
            </div>

            <div class="team-page__art-item team-page__art-item--defense">
              <TeamGirl3Svg />
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
