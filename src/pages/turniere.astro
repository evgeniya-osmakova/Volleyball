---
import BaseLayout from '../layouts/BaseLayout.astro';
import { turniereMatches, bvvBrandenburgligaFrauenUrl } from '../data/site';
---

<BaseLayout title="Turniere | Saarower VSV" description="Aktuelle Spiele und Turniertermine des Saarower VSV">
    <section class="home-canvas legal-page">
        <div class="shell">
            <div class="home-canvas__inner legal-page__inner">
                <div class="hero-stage">
                    <div class="subpage-back-row legal-content-page__back-row">
                        <a class="subpage-back-link" href="/">← Zur Startseite</a>
                    </div>

                    <div class="hero-stage__body legal-content-page__hero-copy">
                        <h1>Turniere</h1>
                    </div>
                </div>

                <article class="legal-card legal-content-page__card">
                    <div class="legal-content-page__content">
                        <p class="section-tag">Aktuelle Spiele</p>

                      {turniereMatches.length > 0 ? (
                              <div class="turniere-table-wrap">
                                  <table class="turniere-table">
                                      <thead>
                                      <tr>
                                          <th>Datum</th>
                                          <th>Uhrzeit</th>
                                          <th>Team 1</th>
                                          <th>Team 2</th>
                                          <th>Ort</th>
                                      </tr>
                                      </thead>
                                      <tbody>
                                      {turniereMatches.map((match) => (
                                              <tr>
                                                  <td>{match.date}</td>
                                                  <td>{match.time}</td>
                                                  <td>{match.team1}</td>
                                                  <td>{match.team2}</td>
                                                  <td>{match.location}</td>
                                              </tr>
                                      ))}
                                      </tbody>
                                  </table>
                              </div>
                      ) : (
                              <p>Die nächsten Spiele sind aktuell noch nicht terminiert.</p>
                      )}

                        <div class="turniere-actions">
                            <a
                                    class="turniere-link"
                                    href={bvvBrandenburgligaFrauenUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                            >
                                Zur BVV Homepage Brandenburgliga →
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>
</BaseLayout>
