---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clubName, sponsors, teamCards } from '../data/site';
---

<BaseLayout title="Saarower VSV" description={clubName}>
  <section class="home-canvas">
    <div class="shell">
      <div class="home-canvas__inner">
        <section class="hero-stage" id="verein">
          <figure class="hero-stage__poster">
            <img src="/images/home/hero-team.jpg" alt="Mannschaftsfoto des Saarower VSV" />
          </figure>

          <div class="hero-stage__body" id="probetraining">
            <h1>Willkommen beim Volleyballverein</h1>
            <a class="button hero-stage__cta" href="#kontakt">Probetraining</a>
          </div>
        </section>

        <section class="training-ribbon" id="teams">
          <div class="section-head">
            <p class="section-tag">Trainingszeiten</p>
            <h2>Unsere Teams</h2>
          </div>

          <div class="training-ribbon__board">
            {
              teamCards.map((team) => (
                <article class={`training-row training-row--${team.accent}`}>
                  <div class="training-row__headline">
                    <p class="training-row__name">{team.name}</p>
                    <p class="training-row__description">{team.description}</p>
                    <div class="training-row__contact">
                      <p class="training-row__contact-label">
                        <span>{`${team.name === 'mix' || team.name === 'damen' ? 'Ansprechpartner' : 'Trainer und Ansprechpartner'}`}</span>
                      </p>
                      <p class="training-row__contact-name">{team.contactName}</p>
                    </div>
                  </div>

                  <div class="training-row__aside">
                    <ul class="training-row__schedule">
                      {team.schedule.map((entry) => <li>{entry}</li>)}
                    </ul>

                    <a class="training-row__link" href={`/teams/${team.slug}`}>
                      Details zum Team
                    </a>
                  </div>

                  <div class="training-row__mark" aria-hidden="true"></div>
                </article>
              ))
            }
          </div>
        </section>

        <section class="sponsors-section" id="sponsoren">
          <div class="section-head sponsors-section__head">
            <p class="section-tag">Sponsoren</p>
            <h2 class="sponsors-section__title">Danke an unsere Partner</h2>
          </div>

          <div class="sponsors-grid">
            {
              sponsors.map((sponsor) => (
                <a
                  class="sponsor-logo-link"
                  href={sponsor.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${sponsor.name} Website öffnen`}
                >
                  <img
                    class="sponsor-logo-image"
                    src={sponsor.logoSrc}
                    alt={sponsor.logoAlt}
                    loading="lazy"
                  />
                </a>
              ))
            }
          </div>

          <div class="sponsors-section__actions">
            <a class="button sponsors-section__cta" href="/sponsoren">Sponsor werden!</a>
          </div>
        </section>

          <section class="contact-section" id="kontakt">
              <div class="section-head contact-section__head">
                  <p class="section-tag">Kontakt</p>
                  <h2 class="contact-section__title">So findet Ihr uns</h2>
              </div>

              <div class="contact-section__grid">
                  <article class="contact-card contact-card--map">
                      <div class="contact-map">
                          <iframe
                                  src="https://www.google.com/maps?q=Pieskower%20Stra%C3%9Fe%2031%2C%2015526%20Bad%20Saarow&output=embed"
                                  loading="lazy"
                                  referrerpolicy="no-referrer-when-downgrade"
                                  allowfullscreen
                                  title="Karte zur Halle"
                          ></iframe>
                      </div>
                  </article>

                  <article class="contact-card contact-card--info">
                      <div class="contact-info">
                          <div class="contact-info__item">
                              <p class="contact-info__label">Adresse</p>
                              <p class="contact-info__text">Saarower Chaussee 21, 15517 Fürstenwalde</p>
                          </div>

                          <div class="contact-info__item">
                              <p class="contact-info__label">Halle</p>
                              <p class="contact-info__text">Pieskower Straße 31, 15526 Bad Saarow</p>
                          </div>

                          <div class="contact-info__item">
                              <p class="contact-info__label">Telefon</p>
                              <p class="contact-info__text">
                                  <a href="tel:+4933617699800">+49 3361 7699800</a>
                              </p>
                          </div>

                          <div class="contact-info__item">
                              <p class="contact-info__label">E-Mail</p>
                              <p class="contact-info__text">
                                  <a href="mailto:saarowervsv@gmail.com">saarowervsv@gmail.com</a>
                              </p>
                          </div>

                          <div class="contact-info__item contact-info__item--form">
                              <p class="contact-info__label">Kontaktformular</p>
                              <form
                                      class="contact-form wpcf7-form"
                                      method="post"
                                      action="#kontakt"
                                      onsubmit="return false;"
                              >
                                  <label class="contact-form__field">
                                      <span class="contact-form__label">Deine E-Mail-Adresse</span>
                                      <input
                                              class="contact-form__control wpcf7-form-control wpcf7-email"
                                              type="email"
                                              name="your-email"
                                              autocomplete="email"
                                      />
                                  </label>

                                  <label class="contact-form__field">
                                      <span class="contact-form__label">Dein Name</span>
                                      <input
                                              class="contact-form__control wpcf7-form-control wpcf7-text"
                                              type="text"
                                              name="your-name"
                                              autocomplete="name"
                                      />
                                  </label>

                                  <label class="contact-form__field">
                                      <span class="contact-form__label">Betreff</span>
                                      <input
                                              class="contact-form__control wpcf7-form-control wpcf7-text"
                                              type="text"
                                              name="your-subject"
                                              autocomplete="off"
                                      />
                                  </label>

                                  <label class="contact-form__field">
                                      <span class="contact-form__label">Deine Nachricht</span>
                                      <textarea
                                              class="contact-form__control contact-form__control--textarea wpcf7-form-control wpcf7-textarea"
                                              name="your-message"
                                              rows="5"
                                      ></textarea>
                                  </label>

                                  <button class="button contact-form__submit wpcf7-form-control wpcf7-submit" type="submit">
                                      Nachricht senden
                                  </button>
                              </form>
                          </div>
                      </div>
                  </article>
              </div>
          </section>
      </div>
    </div>
  </section>
</BaseLayout>
