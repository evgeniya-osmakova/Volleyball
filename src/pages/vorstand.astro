---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Vorstand | Saarower VSV" description="Der Vorstand des Saarower Volleyball Sportverein e.V.">
    <section class="home-canvas legal-page">
        <div class="shell">
            <div class="home-canvas__inner legal-page__inner">
                <div class="hero-stage legal-content-page__hero">
                    <div class="subpage-back-row legal-content-page__back-row">
                        <a class="subpage-back-link" href="/">← Zur Startseite</a>
                    </div>

                    <div class="hero-stage__body legal-content-page__hero-copy">
                        <h1>Vorstand</h1>
                    </div>
                </div>

                <section class="legal-content-page__section">
                    <article class="legal-card legal-content-page__card">
                        <div class="legal-content-page__content">
                            <p>
                                Der Saarower VSV wird mit großem Engagement, Verantwortungsbewusstsein und viel
                                persönlichem Einsatz geführt. Ansprechpartner für organisatorische und vereinsbezogene
                                Anliegen ist der Vorsitzende des Vereins.
                            </p>

                            <hr />

                            <h3>Vorsitzender</h3>

                            <p>
                                <strong>Torsten Ahlert</strong><br />
                                Saarower Chaussee 21<br />
                                15517 Fürstenwalde
                            </p>

                            <p>
                                <strong>Telefon:</strong>
                                <a href="tel:+4933617699800">03361 7699800</a><br />
                                <strong>E-Mail:</strong>
                                <a href="mailto:fam.ahlert@t-online.de">fam.ahlert@t-online.de</a>
                            </p>
                        </div>
                    </article>

                    <div class="legal-content-page__actions">
                        <a class="button sponsors-section__cta legal-content-page__back-link" href="/">
                            Zur Startseite
                        </a>
                    </div>
                </section>
            </div>
        </div>
    </section>
</BaseLayout>
