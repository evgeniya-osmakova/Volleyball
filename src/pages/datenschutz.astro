---
import { privacyLegacyHtml } from '../data/privacyLegacy';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Datenschutz | Saarower VSV"
  description="Datenschutzerklärung des Saarower Volleyball Sportverein e.V."
>
  <section class="home-canvas">
    <div class="shell">
      <div class="home-canvas__inner">
        <section class="hero-stage privacy-page__hero">
          <div class="hero-stage__body privacy-page__hero-copy">
            <h1>Datenschutzerklärung</h1>
          </div>
        </section>

        <section class="privacy-page__section">
          <div class="subpage-back-row privacy-page__back-row">
            <a class="subpage-back-link" href="/">&larr; Zurück zur Startseite</a>
          </div>

          <article class="legal-card privacy-page__card">
            <div class="privacy-page__content" set:html={privacyLegacyHtml}></div>
          </article>

          <div class="privacy-page__actions">
            <a class="button sponsors-section__cta privacy-page__back-link" href="/">
              Zur Startseite
            </a>
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
