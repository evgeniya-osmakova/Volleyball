---
import { privacySections } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Datenschutz | Saarower VSV"
  description="Diese Datenschutzerklärung klärt Sie über die Art, den Umfang und Zweck der Verarbeitung von personenbezogenen Daten innerhalb dieses Onlineangebotes auf."
>
  <section class="legal-page">
    <div class="shell legal-page__inner">
      <div class="legal-intro">
        <p class="section-tag">Datenschutzerklärung</p>
        <h1>Datenschutz</h1>
        <p>
          Diese Datenschutzerklärung klärt Sie über die Art, den Umfang und Zweck der
          Verarbeitung von personenbezogenen Daten innerhalb dieses Onlineangebotes und der mit
          ihm verbundenen Webseiten, Funktionen und Inhalte auf.
        </p>
      </div>

      <div class="legal-grid">
        {
          privacySections.map((section) => (
            <article class="legal-card">
              <h2>{section.title}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
