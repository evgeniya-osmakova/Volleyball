---
import SubpageHero from '../components/SubpageHero.astro';
import { privacyLegacyHtml } from '../data/privacyLegacy';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Datenschutz | Saarower VSV"
  description="Datenschutzerklärung des Saarower Volleyball Sportverein e.V."
>
  <section class="home-canvas">
    <div class="shell">
      <div class="home-canvas__inner">
        <SubpageHero
          class="hero-stage legal-content-page__hero"
          backHref="/"
          backLabel="Zurück zur Startseite"
          backRowClass="legal-content-page__back-row"
          bodyClass="hero-stage__body legal-content-page__hero-copy"
        >
          <h1>Datenschutzerklärung</h1>
        </SubpageHero>

        <section class="legal-content-page__section">
          <article class="legal-card legal-content-page__card">
            <div class="legal-content-page__content" set:html={privacyLegacyHtml}></div>
          </article>

          <div class="legal-content-page__actions">
            <a class="button sponsors-section__cta legal-content-page__back-link" href="/">
              Zur Startseite
            </a>
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
