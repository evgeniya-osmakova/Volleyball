---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpielberichteList from '../components/SpielberichteList.astro';
import { spielberichte } from '../data/site';
---

<BaseLayout title="Spielberichte | Saarower VSV" description="Aktuelle Spielberichte des Saarower VSV">
    <section class="home-canvas legal-page">
        <div class="shell">
            <div class="home-canvas__inner legal-page__inner">
                <div class="hero-stage">
                    <div class="subpage-back-row legal-content-page__back-row">
                        <a class="subpage-back-link" href="/">← Zur Startseite</a>
                    </div>

                    <div class="hero-stage__body legal-content-page__hero-copy">
                        <h1>Spielberichte</h1>
                    </div>
                </div>

                <SpielberichteList posts={spielberichte} emptyText="Aktuell sind noch keine Spielberichte verfügbar." />
            </div>
        </div>
    </section>
</BaseLayout>
